# Optional: copy to ~/lofi_auto/config.env. Shell syntax; loaded by launchers.
ACE_ROOT="$HOME/ACE-Step-1.5"
LOFI_PYTHON="$ACE_ROOT/.venv/bin/python"
LOFI_MUSIC_DIR="$HOME/lofi_auto/music"
# RTX 3060 CUDA with CPU offload; resident keeps DiT on GPU (more VRAM).
# See docs/RTX3060.md. Changes require an idle server restart.
LOFI_ACE_PROFILE=rtx3060
# Proven model settings and service resource limits are in run_ace.sh / setup.sh.
# Connect publishing/archive accounts using connect_youtube.sh, connect_vk.sh,
# and connect_yandex.sh. Tokens are stored privately under LOFI_WEB_DATA.

# Web studio (separate from ACE-Step on 7860):
LOFI_WEB_HOST=0.0.0.0
LOFI_WEB_PORT=7861
# Optional custom queue/password/logs location:
# LOFI_WEB_DATA="$HOME/lofi_auto/web_data"
